    <actionsetting name="Remove Image" capture="0" icon="" action="import os&#xa;from qgis.utils import iface&#xa;from qgis.core import QgsProject, QgsRasterLayer&#xa;from osgeo import gdal&#xa;&#xa;def _norm(p):&#xa;    return os.path.normcase(os.path.normpath(p))&#xa;&#xa;def _tile_path(layer, fid):&#xa;    loc = layer.getFeature(fid)[&#x27;location&#x27;]&#xa;    if not loc:&#xa;        return None&#xa;    if not os.path.isabs(loc):&#xa;        loc = os.path.join(os.path.dirname(layer.source().split(&#x27;|&#x27;)[0]), loc)&#xa;    return os.path.normpath(loc)&#xa;&#xa;def _vendor_date(path):&#xa;    vendor, date = &#x27;Unknown_Vendor&#x27;, &#x27;Unknown_Date&#x27;&#xa;    try:&#xa;        ds = gdal.Open(path)&#xa;        md = {}&#xa;        for dom in (&#x27;&#x27;, &#x27;IMAGERY&#x27;):&#xa;            md.update(ds.GetMetadata(dom) or {})&#xa;        ds = None&#xa;        vendor = (md.get(&#x27;vendor&#x27;) or &#x27;&#x27;).strip() or vendor&#xa;        date = (md.get(&#x27;acquisitionTime&#x27;) or &#x27;&#x27;).strip()[:10] or date&#xa;    except Exception:&#xa;        pass&#xa;    return vendor, date&#xa;&#xa;def _matching_layers(path):&#xa;    return [l for l in QgsProject.instance().mapLayers().values()&#xa;            if isinstance(l, QgsRasterLayer)&#xa;            and _norm(l.source().split(&#x27;|&#x27;)[0]) == _norm(path)]&#xa;&#xa;def _child_group(parent, name):&#xa;    for child in parent.children():&#xa;        if hasattr(child, &#x27;addGroup&#x27;) and child.name() == name:&#xa;            return child&#xa;    return parent.addGroup(name)&#xa;&#xa;index_layer = QgsProject.instance().mapLayer(&#x27;[%@layer_id%]&#x27;)&#xa;try:&#xa;    fid = int(&#x27;[%&quot;fid&quot;%]&#x27;)&#xa;except ValueError:&#xa;    fid = None&#xa;try:&#xa;    path = _tile_path(index_layer, fid) if index_layer is not None and fid is not None else None&#xa;except Exception:&#xa;    path = None&#xa;root = QgsProject.instance().layerTreeRoot()&#xa;&#xa;if not path:&#xa;    iface.messageBar().pushCritical(&#x27;Error&#x27;, &#x27;No tile path found for this feature&#x27;)&#xa;else:&#xa;    layers = _matching_layers(path)&#xa;    if not layers:&#xa;        iface.messageBar().pushCritical(&#x27;Error&#x27;, &#x27;Raster tile %s is not loaded&#x27; % os.path.basename(path))&#xa;    else:&#xa;        vendor, date = _vendor_date(path)&#xa;        names = (vendor, date, &#x27;Unknown_Vendor&#x27;, &#x27;Unknown_Date&#x27;)&#xa;        for lyr in layers:&#xa;            node = root.findLayer(lyr.id())&#xa;            parent = node.parent() if node is not None else None&#xa;            QgsProject.instance().removeMapLayer(lyr.id())&#xa;            while parent is not None and parent is not root and not parent.children() and parent.name() in names:&#xa;                grand = parent.parent()&#xa;                grand.removeChildNode(parent)&#xa;                parent = grand&#xa;        iface.messageBar().pushSuccess(&#x27;Success&#x27;, &#x27;Raster tile %s removed&#x27; % os.path.basename(path))&#xa;if index_layer is not None:&#xa;    iface.setActiveLayer(index_layer)&#xa;" shortTitle="" isEnabledOnlyWhenEditable="0" type="1" notificationMessage="" id="{16f6c1df-31e9-44b1-8434-fb46d99007ee}">
